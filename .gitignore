node_modules/
dist/
dist-ssr/
*.local

# Generated by the AST pipeline at build time (§4.2, §12) — never committed, so a
# stale graph can't ship and the artifact never shows up in a diff.
public/ast-graph.json
public/source-index.json

# Incremental build state. Also: if `tsc` is ever run without `noEmit`, it will drop
# compiled .js next to every source file — if you see those, delete them; don't commit.
*.tsbuildinfo

# Playwright
playwright-report/
test-results/
/blob-report/
.playwright/

.DS_Store
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
